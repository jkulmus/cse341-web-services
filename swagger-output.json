{
  "openapi": "3.0.0",
  "info": {
    "title": "Contacts API",
    "description": "Create, view, update, and delete contacts stored in MongoDB. Each contact has firstName, lastName, email, favoriteColor, and birthday",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API server"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Manage contacts"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/contacts/": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get all contacts",
        "description": "Return every contact in the contacts collection.",
        "responses": {
          "200": {
            "description": "Array of contacts. An empty collection returns an empty array.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Contact"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unable to retrieve contacts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create a contact",
        "description": "Supply all five contact fields as nonblank strings. The response contains the new contact ID.",
        "responses": {
          "201": {
            "description": "Contact created. Copy the returned id for the GET by ID, PUT, and DELETE requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedContact"
                }
              }
            }
          },
          "400": {
            "description": "One or more contact fields are missing, blank, or not strings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "500": {
            "description": "Unable to create contact.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactInput"
              }
            }
          }
        }
      }
    },
    "/contacts/single": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get one contact by ID",
        "description": "Supply a contact ID in the id query parameter.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "24-character hexadecimal MongoDB contact ID. Use an ID returned by GET all or POST.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching contact.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "400": {
            "description": "Contact ID is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "404": {
            "description": "Contact not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "500": {
            "description": "Unable to retrieve contact.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    },
    "/contacts/{id}": {
      "put": {
        "tags": [
          "Contacts"
        ],
        "summary": "Update a contact",
        "description": "Supply an existing contact ID and all five contact fields. All five fields are required even when changing just one.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "24-character hexadecimal MongoDB ID of the contact to update."
          }
        ],
        "responses": {
          "204": {
            "description": "Contact updated successfully. No response body is returned."
          },
          "400": {
            "description": "Contact ID is invalid, or one or more contact fields are missing, blank, or not strings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "404": {
            "description": "Contact not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "500": {
            "description": "Unable to update contact.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactInput"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Contacts"
        ],
        "summary": "Delete a contact",
        "description": "Delete the contact matching the supplied ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "24-character hexadecimal MongoDB ID of the contact to delete."
          }
        ],
        "responses": {
          "200": {
            "description": "Contact deleted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Contact deleted successfully"
                }
              }
            }
          },
          "400": {
            "description": "Contact ID is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "404": {
            "description": "Contact not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "500": {
            "description": "Unable to delete contact.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContactInput": {
        "type": "object",
        "description": "All five fields must contain nonblank text. Leading and trailing whitespace is removed. Email and birthday formats are not validated by this API. Extra fields are ignored",
        "required": [
          "firstName",
          "lastName",
          "email",
          "favoriteColor",
          "birthday"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "pattern": "\\s",
            "example": "Demo"
          },
          "lastName": {
            "type": "string",
            "pattern": "\\s",
            "example": "Contact"
          },
          "email": {
            "type": "string",
            "pattern": "\\s",
            "example": "demo@example.com"
          },
          "favoriteColor": {
            "type": "string",
            "pattern": "\\s",
            "example": "Blue"
          },
          "birthday": {
            "type": "string",
            "pattern": "\\s",
            "example": "2000-01-01"
          }
        }
      },
      "Contact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ContactInput"
          },
          {
            "type": "object",
            "required": [
              "_id"
            ],
            "properties": {
              "_id": {
                "type": "string",
                "description": "MongoDB conact ID",
                "pattern": "^[a-fA-F0-9]{24}$",
                "example": "507f1f77bcf86cd799439011"
              }
            }
          }
        ]
      },
      "CreatedContact": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}